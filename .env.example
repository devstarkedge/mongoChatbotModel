# ==============================================================================
# Environment Configuration Template
# Copy this file to '.env' and adjust the values for your environment.
# NEVER commit the '.env' file containing real secrets to version control!
# ==============================================================================

# --- MongoDB Configuration (Required) ---
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<dbname>
MONGO_DATABASE=your_database_name

# --- Authentication & Security ---
# Secret key used for JWT verification between backend and frontend
JWT_SECRET=your-jwt-secret-key-change-me

# Token to protect POST /api/v1/ingest/ (required when DJANGO_DEBUG=False)
INGEST_TOKEN=your-secure-ingest-token

# --- LLM Provider Settings ---
# Options: "gemini" | "openai" | "ollama"
LLM_PROVIDER=gemini

# For Gemini (Google AI Studio: https://aistudio.google.com/apikey):
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-3.5-flash-lite

# For OpenAI / Groq / OpenAI-compatible provider (uncomment if using):
# LLM_PROVIDER=openai
# LLM_API_KEY=your-api-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# For Local Ollama (uncomment if using):
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# LLM_MODEL=gemma3:4b

# --- Embeddings Configuration ---
# Options: "local" (uses sentence-transformers on CPU) | "openai"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# VECTOR_STORE_DIR=vector_store

# --- RAG & Search Tuning ---
TOP_K=5
MIN_SCORE=0.15
HYBRID_SEARCH=true
KEYWORD_WEIGHT=0.5
MAX_HOPS=1
STRUCTURED_QUERIES=true
STRUCT_PLANNER=false
CACHE_TTL_SECONDS=600

# Optional filtering
# EXCLUDE_COLLECTIONS=logs,sessions,activities
# EXCLUDE_FIELDS=ssn,password,token

# --- Django Settings ---
DJANGO_SECRET_KEY=django-insecure-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
