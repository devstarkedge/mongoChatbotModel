# ==============================================================================
# Environment Configuration Template
# Copy this file to '.env' and adjust the values for your environment.
# NEVER commit the '.env' file containing real secrets to version control!
# ==============================================================================

# --- MongoDB Configuration (Required) ---
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<dbname>
MONGO_DATABASE=your_database_name

# --- Qdrant vector storage (required) ---
# Qdrant Cloud: set the cluster URL and API key from the cluster dashboard.
QDRANT_URL=https://your-cluster.example.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=rag_chunks
QDRANT_TIMEOUT=60
QDRANT_UPSERT_BATCH_SIZE=100
# For local embedded development, use QDRANT_PATH=./qdrant_data instead of URL/API key.
# QDRANT_PATH=

# --- Authentication & Security ---
# Secret key used for JWT verification between backend and frontend
JWT_SECRET=your-jwt-secret-key-change-me

# Token to protect POST /api/v1/ingest/ (required when DJANGO_DEBUG=False)
INGEST_TOKEN=your-secure-ingest-token

# --- LLM Provider Settings ---
# Only Gemini is supported.
LLM_PROVIDER=gemini

# Gemini (Google AI Studio: https://aistudio.google.com/apikey):
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-3.5-flash-lite

# --- Optional LLM fallback ---
# If the provider above fails (outage, geo-block, rate limit), retry on a second
# OpenAI-compatible provider. Leave LLM_FALLBACK_PROVIDER empty to disable.
# For Groq the API key defaults to GROQ_API_KEY.
# LLM_FALLBACK_PROVIDER=openai
# LLM_FALLBACK_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# LLM_FALLBACK_API_KEY=your-groq-api-key-here
# GROQ_API_KEY=your-groq-api-key-here

# --- Embeddings Configuration ---
# Options: "local" (uses sentence-transformers on CPU) | "openai"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# --- RAG & Search Tuning ---
TOP_K=5
MIN_SCORE=0.15
HYBRID_SEARCH=true
KEYWORD_WEIGHT=0.5
MAX_HOPS=1
STRUCTURED_QUERIES=true
STRUCT_PLANNER=false
CACHE_TTL_SECONDS=600

# Optional hosted Mem0 memory. Questions are sent to Mem0 when enabled.
MEM0_ENABLED=false
# MEM0_API_KEY=

# Optional filtering
# EXCLUDE_COLLECTIONS=logs,sessions,activities
# EXCLUDE_FIELDS=ssn,password,token

# --- Django Settings ---
DJANGO_SECRET_KEY=django-insecure-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

